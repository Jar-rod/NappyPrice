# Copy to .env for local runs. The same names go into GitHub Actions secrets
# (scraper) and Streamlit secrets (app). Never commit the real values.

# Supabase. Leave both blank to use a local JSON file (.local_db.json) instead.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Alerts
NTFY_TOPIC=                 # long, hard-to-guess topic name both phones subscribe to
RESEND_API_KEY=
EMAIL_FROM=                 # e.g. "Nappy Price Watch <alerts@yourdomain.co.za>"
ALERT_EMAILS=               # who gets alert emails, comma-separated

# App
APP_PASSWORD=               # shared password for the app; with none set, nobody can get in
GITHUB_REPO=Jar-rod/NappyPrice
GITHUB_TOKEN=               # fine-grained token, Actions: read and write, this repo only
GITHUB_REF=main

# Store regions (optional). Prices at these two stores depend on where you are.
PNP_STORE_CODE=             # Pick n Pay region, default WC21
CHECKERS_ADDRESS_JSON=      # Checkers delivery address; default is Sandton City (see scraper/adapters/checkers.py)

# Local development only
AUTH_BYPASS=                # 1 = skip the password (ignored when Supabase is configured)
